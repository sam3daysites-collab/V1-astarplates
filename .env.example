# A Star Number Plates — Phase 1 admin env.
# Copy to `.env.local` and fill the values. None of these are committed.

# ---------------------------------------------------------------------------
# Supabase (required for /admin to function).
# Find URL + anon key in Supabase Studio → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. NEVER prefix with NEXT_PUBLIC_.
# This key bypasses RLS. Only imported by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin allowlist (V1).
# Comma-separated list of emails permitted to access /admin/*.
# Any signed-in user not in this list is rejected.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Phase 2 — Stripe (not wired yet).
# Leave blank until the checkout/webhook is built.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
